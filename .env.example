# Copiar como .env y ajustar según el entorno. Ningún valor por defecto
# de config.py es sensible; este archivo permite sobreescribir cualquiera.

# --- Aplicación ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Motor IA: datasets activos (lista separada por comas) ---
DATASETS=["wesad"]

# --- Motor IA: ventaneo de señal ---
SIGNAL_SAMPLE_RATE_HZ=700
WINDOW_SECONDS=60
WINDOW_OVERLAP=0.5

# --- Motor IA: entrenamiento ---
CV_STRATEGY=loso
CV_N_FOLDS=5
RANDOM_SEED=42
OPTUNA_N_TRIALS=30

# --- ABM ---
ABM_DEFAULT_N_AGENTS=30
ABM_MONTE_CARLO_RUNS=100
ABM_MAX_STEPS=2000

# --- Intervención adaptativa ---
STRESS_THRESHOLD_MODERATE=0.4
STRESS_THRESHOLD_HIGH=0.75

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
WEBSOCKET_BROADCAST_HZ=10
